<%- | Enum['private', 'public']      $ssh_ip_mode,
      Enum['google', 'aws', 'azure', 'proxmox'] $provider,
      Hash                           $ssh_config,
| -%>
<%- case $provider { -%>
  <%- 'google': { -%>
    <%- $uri_param = $ssh_ip_mode ? { -%>
      <%- 'private' => 'network_interface.0.network_ip', -%>
      <%- 'public'  => 'network_interface.0.access_config.0.nat_ip' -%>
    <%- } -%>
  <%- } -%>
  <%- 'aws': { -%>
    <%- $uri_param = $ssh_ip_mode ? { -%>
      <%- 'private' => 'private_ip', -%>
      <%- 'public'  => 'public_ip' -%>
    <%- } -%>
  <%- } -%>
  <%- 'azure': { -%>
    <%- $uri_param = $ssh_ip_mode ? { -%>
      <%- 'private' => 'private_ip_address', -%>
      <%- 'public'  => 'public_ip_address' -%>
    <%- } -%>
  <%- } -%>
  <%- 'proxmox': { -%>
    <%- $uri_param = 'ipv4_addresses.1.0' -%>
  <%- } -%>
<%- } -%>
---
config:
  transport: ssh
  ssh:
<%- $ssh_config.each |$key, $value| { -%>
    <%= $key %>: <%= stdlib::to_json($value) %>
<%- } -%>
groups:
  - name: peadm_nodes
    targets:
    <%- if $provider == 'google' { -%>
      - _plugin: terraform
        dir: .terraform/google_pe_arch
        resource_type: google_compute_instance.server
        target_mapping:
          name: metadata.internalDNS
          uri: <%= $uri_param %>
      - _plugin: terraform
        dir: .terraform/google_pe_arch
        resource_type: google_compute_instance.compiler
        target_mapping:
          name: metadata.internalDNS
          uri: <%= $uri_param %>
      - _plugin: terraform
        dir: .terraform/google_pe_arch
        resource_type: google_compute_instance.psql
        target_mapping:
          name: metadata.internalDNS
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'aws' { -%>
      - _plugin: terraform
        dir: .terraform/aws_pe_arch
        resource_type: aws_instance.server
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
      - _plugin: terraform
        dir: .terraform/aws_pe_arch
        resource_type: aws_instance.compiler
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
      - _plugin: terraform
        dir: .terraform/aws_pe_arch
        resource_type: aws_instance.psql
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'azure' { -%>
      - _plugin: terraform
        dir: .terraform/azure_pe_arch
        resource_type: azurerm_linux_virtual_machine.server
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
      - _plugin: terraform
        dir: .terraform/azure_pe_arch
        resource_type: azurerm_linux_virtual_machine.compiler
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
      - _plugin: terraform
        dir: .terraform/azure_pe_arch
        resource_type: azurerm_linux_virtual_machine.psql
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'proxmox' { -%>
      - _plugin: terraform
        dir: .terraform/proxmox_pe_arch
        resource_type: proxmox_virtual_environment_vm.server
        target_mapping:
          name: name
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'proxmox' { -%>
      - _plugin: terraform
        dir: .terraform/proxmox_pe_arch
        resource_type: proxmox_virtual_environment_vm.compiler
        target_mapping:
          name: name
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'proxmox' { -%>
      - _plugin: terraform
        dir: .terraform/proxmox_pe_arch
        resource_type: proxmox_virtual_environment_vm.psql
        target_mapping:
          name: name
          uri: <%= $uri_param %>
    <%- } -%>
  - name: agent_nodes
    targets:
    <%- if $provider == 'google' { -%>
      - _plugin: terraform
        dir: .terraform/google_pe_arch
        resource_type: google_compute_instance.node
        target_mapping:
          name: metadata.internalDNS
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'aws' { -%>
      - _plugin: terraform
        dir: .terraform/aws_pe_arch
        resource_type: aws_instance.node
        target_mapping:
          name: public_dns
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'azure' { -%>
      - _plugin: terraform
        dir: .terraform/azure_pe_arch
        resource_type: azurerm_linux_virtual_machine.node
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'proxmox' { -%>
      - _plugin: terraform
        dir: .terraform/proxmox_pe_arch
        resource_type: proxmox_virtual_environment_vm.node
        target_mapping:
          name: name
          uri: <%= $uri_param %>
    <%- } -%>
  - name: windows_agent_nodes
    targets:
    <%- if $provider == 'google' { -%>
      - _plugin: terraform
        dir: .terraform/google_pe_arch
        resource_type: google_compute_instance.windows_node
        target_mapping:
          name: metadata.internalDNS
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'aws' { -%>
      - _plugin: terraform
        dir: .terraform/aws_pe_arch
        resource_type: aws_instance.windows_node
        target_mapping:
          name: public_dns
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'azure' { -%>
      - _plugin: terraform
        dir: .terraform/azure_pe_arch
        resource_type: azurerm_windows_virtual_machine.windows_node
        target_mapping:
          name: tags.internalDNS
          uri: <%= $uri_param %>
    <%- } -%>
    <%- if $provider == 'proxmox' { -%>
      - _plugin: terraform
        dir: .terraform/proxmox_pe_arch
        resource_type: proxmox_virtual_environment_vm.windows_node
        target_mapping:
          name: name
          uri: <%= $uri_param %>
    <%- } -%>
    config:
      transport: winrm
      winrm:
        ssl: false   
